generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  username      String    @unique
  email         String?   @unique
  phone         String?   @unique
  phoneVerified Boolean   @default(false) @map("phone_verified")
  passwordHash  String
  role          String    @default("dispatcher") // "dispatcher" | "hospital" | "admin"
  hospitalId    String?   @map("hospital_id")
  ambulanceId   String?   @map("ambulance_id")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  hospital      Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([role])
  @@index([hospitalId])
  @@index([phone])
  @@map("users")
}

model OtpVerification {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model Hospital {
  id                  String           @id // "kem", "jj-hospital", "sion", etc.
  name                String
  area                String
  address             String?
  city                String?          @default("Mumbai")
  state               String?          @default("Maharashtra")
  pincode             String?
  phone               String?
  hospitalType        String?          @default("Multispeciality") @map("hospital_type")
  lat                 Float
  lng                 Float
  active              Boolean          @default(true)
  verified            Boolean          @default(true)
  source              String?          @default("DMER Maharashtra")
  sourceReference     String?          @map("source_reference")
  sourceVerifiedAt    DateTime?        @default(now()) @map("source_verified_at")
  loadPct             Float            @default(0) @map("load_pct")
  specialties         String[]         @default([])
  heartbeat           Boolean          @default(true)
  
  // Hospital Capabilities (Supported services vs current live availability)
  icuSupported        Boolean          @default(true) @map("icu_supported")
  ventilatorSupported Boolean          @default(true) @map("ventilator_supported")
  oxygenSupported     Boolean          @default(true) @map("oxygen_supported")
  cardiacSupported    Boolean          @default(true) @map("cardiac_supported")
  burnsSupported      Boolean          @default(false) @map("burns_supported")
  traumaSupported     Boolean          @default(true) @map("trauma_supported")
  emergencyDepartment Boolean          @default(true) @map("emergency_department")

  updatedAt           DateTime         @default(now()) @map("updated_at")
  createdAt           DateTime         @default(now()) @map("created_at")

  staff               User[]
  availability        BedAvailability?
  responses           HospitalResponse[]
  reservations        Reservation[]
  events              EventLog[]

  @@index([active])
  @@index([verified])
  @@index([lat, lng])
  @@map("hospitals")
}

model BedAvailability {
  id                  String   @id @default(cuid())
  hospitalId          String   @unique @map("hospital_id")
  hospital            Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  icuAvailable        Int      @default(0) @map("icu_available")
  icuTotal            Int      @default(0) @map("icu_total")
  ventilatorAvailable Int      @default(0) @map("ventilator_available")
  ventilatorTotal     Int      @default(0) @map("ventilator_total")
  cardiacAvailable    Int      @default(0) @map("cardiac_available")
  cardiacTotal        Int      @default(1) @map("cardiac_total")
  oxygenAvailable     Int      @default(0) @map("oxygen_available")
  oxygenTotal         Int      @default(0) @map("oxygen_total")
  burnsAvailable      Int      @default(0) @map("burns_available")
  burnsTotal          Int      @default(1) @map("burns_total")
  isConfirmedLive     Boolean  @default(false) @map("is_confirmed_live")
  availabilitySource  String?  @default("HOSPITAL_STAFF") @map("availability_source")
  lastUpdated         DateTime @default(now()) @map("last_updated")
  updatedBy           String?  @map("updated_by")

  @@map("bed_availabilities")
}

model Ambulance {
  id             String             @id // "A12", "A07"
  vehicleNumber  String             @map("vehicle_number")
  driverName     String             @map("driver_name")
  driverPhone    String             @map("driver_phone")
  paramedicName  String             @map("paramedic_name")
  paramedicPhone String             @map("paramedic_phone")
  crewSize       Int                @default(2) @map("crew_size")
  operatorName   String             @map("operator_name")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  requests       EmergencyRequest[]

  @@map("ambulances")
}

model EmergencyRequest {
  id                String             @id // "REQ-..."
  ambulanceId       String?            @map("ambulance_id")
  ambulance         Ambulance?         @relation(fields: [ambulanceId], references: [id])
  patientReference  String?            @map("patient_reference")
  age               Int?
  gender            String?
  type              String             // "Trauma" | "Cardiac" | "Respiratory" | "Burns" | "Other"
  severity          String             // "Critical" | "Serious" | "Stable"
  lat               Float
  lng               Float
  locationLabel     String             @map("location_label")
  requiresIcu       Boolean            @default(false) @map("requires_icu")
  requiresVentilator Boolean           @default(false) @map("requires_ventilator")
  requiresCardiac   Boolean            @default(false) @map("requires_cardiac")
  requiresOxygen    Boolean            @default(false) @map("requires_oxygen")
  requiresBurns     Boolean            @default(false) @map("requires_burns")
  resources         String[]           @default([])
  specialty         String?
  status            String             @default("matching") // "matching" | "reserving" | "held" | "failed" | "cancelled" | "completed"
  createdBy         String?            @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  reservations      Reservation[]
  responses         HospitalResponse[]
  events            EventLog[]

  @@index([status])
  @@index([createdAt])
  @@map("emergency_requests")
}

model HospitalResponse {
  id                    String           @id @default(cuid())
  emergencyId           String           @map("emergency_id")
  emergency             EmergencyRequest @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  hospitalId            String           @map("hospital_id")
  hospital              Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  icu                   Boolean          @default(false)
  ventilator            Boolean          @default(false)
  oxygen                Boolean          @default(false)
  cardiac               Boolean          @default(false)
  burns                 Boolean          @default(false)
  requirementsFulfilled Int              @default(0) @map("requirements_fulfilled")
  requirementsTotal     Int              @default(0) @map("requirements_total")
  fulfillmentPercentage Float            @default(0) @map("fulfillment_percentage")
  status                String           @default("RECORDED")
  respondedAt           DateTime         @default(now()) @map("responded_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([emergencyId])
  @@index([hospitalId])
  @@map("hospital_responses")
}

model Reservation {
  id            String           @id // "RSV-..."
  requestId     String           @map("request_id")
  emergency     EmergencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  hospitalId    String           @map("hospital_id")
  hospital      Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  status        String           @default("RESERVATION_REQUESTED") // "RESERVATION_REQUESTED" | "ACCEPTED" | "HELD" | "REJECTED" | "TIMEOUT" | "CANCELLED" | "RELEASED"
  score         Float            @default(0)
  attempt       Int              @default(1)
  startsAt      DateTime         @default(now()) @map("starts_at")
  expiresAt     DateTime         @map("expires_at")
  respondedAt   DateTime?        @map("responded_at")
  respondedBy   String?          @map("responded_by")
  resolvedAt    DateTime?        @map("resolved_at")
  arrivedAt     DateTime?        @map("arrived_at")
  viewedAt      DateTime?        @map("viewed_at")
  rejectReasons String[]         @default([]) @map("reject_reasons")
  rejectNote    String?          @map("reject_note")
  releaseReason String?          @map("release_reason")
  held          Json?            @default("{}") // held resources map
  holdToken     String?          @map("hold_token")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  events        EventLog[]

  @@index([requestId])
  @@index([hospitalId])
  @@index([status])
  @@index([expiresAt])
  @@map("reservations")
}

model EventLog {
  id            String            @id @default(cuid())
  ts            BigInt            // Unix ms timestamp
  requestId     String?           @map("request_id")
  emergency     EmergencyRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  hospitalId    String?           @map("hospital_id")
  hospital      Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  reservationId String?           @map("reservation_id")
  reservation   Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  actor         String
  type          String            // "REQUEST_CREATED" | "MATCHES_RANKED" | "RESERVATION_REQUESTED" | etc.
  message       String
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([requestId])
  @@index([hospitalId])
  @@index([type])
  @@index([ts])
  @@map("event_logs")
}
